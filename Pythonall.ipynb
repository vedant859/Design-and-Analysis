# 3. NAIVE STRING MATCHING
# Display all positions where the pattern occurs.
# Positions are zero-based.
# ============================================================

text = input("Enter text: ")
pattern = input("Enter pattern: ")

n = len(text)
m = len(pattern)
found = False

for i in range(n - m + 1):
    if text[i:i + m] == pattern:
        print("Pattern found at position:", i)
        found = True

if not found:
    print("Pattern not found")


# ============================================================
# 4. RABIN-KARP STRING MATCHING
# Uses rolling hash values.
# Positions are zero-based.
# ============================================================

text = input("Enter text: ")
pattern = input("Enter pattern: ")

d = 256
q = 101
n = len(text)
m = len(pattern)

if m == 0:
    print("Empty pattern")
elif m > n:
    print("Pattern not found")
else:
    pattern_hash = 0
    text_hash = 0
    h = pow(d, m - 1, q)

    for i in range(m):
        pattern_hash = (d * pattern_hash + ord(pattern[i])) % q
        text_hash = (d * text_hash + ord(text[i])) % q

    found = False

    for i in range(n - m + 1):
        if pattern_hash == text_hash:
            if text[i:i + m] == pattern:
                print("Pattern found at position:", i)
                found = True

        if i < n - m:
            text_hash = (
                d * (text_hash - ord(text[i]) * h)
                + ord(text[i + m])
            ) % q

            if text_hash < 0:
                text_hash += q

    if not found:
        print("Pattern not found")


