# ============================================================
# 12. GRAPH COLORING USING BACKTRACKING
# Vertices are numbered from 0 to V-1.
# Enter the adjacency matrix using 0 and 1.
# ============================================================

def is_safe(vertex, color, graph, colors):
    for i in range(len(graph)):
        if graph[vertex][i] == 1 and colors[i] == color:
            return False
    return True


def solve_coloring(vertex, graph, m, colors):
    if vertex == len(graph):
        return True

    for color in range(1, m + 1):
        if is_safe(vertex, color, graph, colors):
            colors[vertex] = color

            if solve_coloring(vertex + 1, graph, m, colors):
                return True

            colors[vertex] = 0

    return False


V = int(input("Enter number of vertices: "))
graph = []

print("Enter adjacency matrix:")

for i in range(V):
    graph.append(list(map(int, input().split())))

m = int(input("Enter number of colors: "))
colors = [0] * V

if solve_coloring(0, graph, m, colors):
    print("Color assigned to each vertex:", colors)
else:
    print("No valid coloring possible")


# ============================================================
# 13. SUBSET SUM USING BACKTRACKING
# Find a subset whose sum equals the target.
# This version assumes non-negative input numbers.
# ============================================================

def subset_sum(arr, target, index=0, current=None):
    if current is None:
        current = []

    if sum(current) == target:
        return current.copy()

    if sum(current) > target or index == len(arr):
        return None

    current.append(arr[index])
    result = subset_sum(arr, target, index + 1, current)

    if result is not None:
        return result

    current.pop()
    return subset_sum(arr, target, index + 1, current)


arr = list(map(int, input("Enter non-negative integers: ").split()))
target = int(input("Enter target sum: "))

result = subset_sum(arr, target)

if result is not None:
    print("Subset found:", result)
else:
    print("No subset found")


# ============================================================
# 14. LONGEST COMMON SUBSEQUENCE (LCS)
# Display the LCS string and its length.
# ============================================================

s1 = input("Enter first string: ")
s2 = input("Enter second string: ")

m = len(s1)
n = len(s2)

dp = [[0] * (n + 1) for i in range(m + 1)]

for i in range(1, m + 1):
    for j in range(1, n + 1):
        if s1[i - 1] == s2[j - 1]:
            dp[i][j] = dp[i - 1][j - 1] + 1
        else:
            dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])

i = m
j = n
lcs = []

while i > 0 and j > 0:
    if s1[i - 1] == s2[j - 1]:
        lcs.append(s1[i - 1])
        i -= 1
        j -= 1
    elif dp[i - 1][j] >= dp[i][j - 1]:
        i -= 1
    else:
        j -= 1

lcs.reverse()

print("LCS:", "".join(lcs))
print("LCS length:", dp[m][n])


# ============================================================
# 15. MATRIX CHAIN MULTIPLICATION
# Find minimum scalar multiplication cost.
# Enter n+1 dimensions for n matrices.
# ============================================================

n = int(input("Enter number of matrices: "))
dimensions = list(map(int, input("Enter matrix dimensions: ").split()))

# Example: 3 matrices with dimensions 10x20, 20x30, 30x40
# Enter: 10 20 30 40

if len(dimensions) != n + 1:
    print("Please enter exactly", n + 1, "dimensions.")
else:
    dp = [[0] * n for i in range(n)]

    for length in range(2, n + 1):
        for i in range(n - length + 1):
            j = i + length - 1
            dp[i][j] = float("inf")

            for k in range(i, j):
                cost = (
                    dp[i][k]
                    + dp[k + 1][j]
                    + dimensions[i] * dimensions[k + 1] * dimensions[j + 1]
                )

                if cost < dp[i][j]:
                    dp[i][j] = cost

    print("Minimum multiplication cost:", dp[0][n - 1])
