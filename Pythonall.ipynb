# ============================================================
# 6. FRACTIONAL KNAPSACK — GREEDY METHOD
# ============================================================

n = int(input("Enter number of items: "))
weights = list(map(float, input("Enter weights: ").split()))
profits = list(map(float, input("Enter profits: ").split()))
capacity = float(input("Enter knapsack capacity: "))

items = []

for i in range(n):
    ratio = profits[i] / weights[i]
    items.append((ratio, weights[i], profits[i], i + 1))

items.sort(reverse=True)

total_profit = 0
remaining = capacity

for ratio, weight, profit, item_id in items:
    if remaining <= 0:
        break

    if weight <= remaining:
        fraction = 1
        remaining -= weight
    else:
        fraction = remaining / weight
        remaining = 0

    total_profit += profit * fraction

    print("Item:", item_id, "Fraction selected:", round(fraction, 2))

print("Maximum profit:", round(total_profit, 2))


# ============================================================
# 7. JOB SEQUENCING WITH DEADLINES
# Greedy method: maximize total profit.
# Input format for each job: ID Deadline Profit
# ============================================================

n = int(input("Enter number of jobs: "))
jobs = []

for i in range(n):
    job_id = input("Enter job ID: ")
    deadline = int(input("Enter deadline: "))
    profit = int(input("Enter profit: "))
    jobs.append((job_id, deadline, profit))

jobs.sort(key=lambda job: job[2], reverse=True)

max_deadline = max(job[1] for job in jobs)
slots = [None] * max_deadline
total_profit = 0

for job_id, deadline, profit in jobs:
    for j in range(min(deadline, max_deadline) - 1, -1, -1):
        if slots[j] is None:
            slots[j] = job_id
            total_profit += profit
            break

print("Selected jobs:", [job for job in slots if job is not None])
print("Maximum profit:", total_profit)


# ============================================================
# 8. KRUSKAL'S MINIMUM SPANNING TREE
# Enter edges as: source destination weight
# Vertices are numbered from 0 to V-1.
# ============================================================

def find(parent, vertex):
    if parent[vertex] != vertex:
        parent[vertex] = find(parent, parent[vertex])
    return parent[vertex]


def union(parent, rank, a, b):
    root_a = find(parent, a)
    root_b = find(parent, b)

    if root_a == root_b:
        return False

    if rank[root_a] < rank[root_b]:
        parent[root_a] = root_b
    elif rank[root_a] > rank[root_b]:
        parent[root_b] = root_a
    else:
        parent[root_b] = root_a
        rank[root_a] += 1

    return True


V = int(input("Enter number of vertices: "))
E = int(input("Enter number of edges: "))

edges = []

for i in range(E):
    u, v, w = map(int, input("Enter source destination weight: ").split())
    edges.append((w, u, v))

edges.sort()

parent = list(range(V))
rank = [0] * V
mst = []
cost = 0

for weight, u, v in edges:
    if union(parent, rank, u, v):
        mst.append((u, v, weight))
        cost += weight

        if len(mst) == V - 1:
            break

if len(mst) == V - 1:
    print("MST edges:", mst)
    print("Total cost:", cost)
else:
    print("Graph is disconnected; MST does not exist.")


# ============================================================
# 9. PRIM'S MINIMUM SPANNING TREE
# Enter an adjacency matrix; use 0 for no edge.
# Vertices are numbered from 0 to V-1.
# ============================================================

V = int(input("Enter number of vertices: "))
graph = []

print("Enter the adjacency matrix:")

for i in range(V):
    row = list(map(int, input().split()))
    graph.append(row)

selected = [False] * V
selected[0] = True
edges_count = 0
total_cost = 0

while edges_count < V - 1:
    minimum = float("inf")
    u = -1
    v = -1

    for i in range(V):
        if selected[i]:
            for j in range(V):
                if not selected[j] and graph[i][j] > 0:
                    if graph[i][j] < minimum:
                        minimum = graph[i][j]
                        u = i
                        v = j

    if u == -1:
        break

    print(u, "-", v, "Weight:", minimum)
    selected[v] = True
    total_cost += minimum
    edges_count += 1

if edges_count == V - 1:
    print("Total MST cost:", total_cost)
else:
    print("Graph is disconnected; MST does not exist.")


# ============================================================
# 10. BINARY SEARCH
# The input list must be sorted in ascending order.
# Position displayed is one-based.
# ============================================================

arr = list(map(int, input("Enter sorted integers: ").split()))
key = int(input("Enter key to search: "))

low = 0
high = len(arr) - 1
position = -1

while low <= high:
    mid = (low + high) // 2

    if arr[mid] == key:
        position = mid
        break
    elif arr[mid] < key:
        low = mid + 1
    else:
        high = mid - 1

if position != -1:
    print("Element found at position:", position + 1)
else:
    print("Element not found")


