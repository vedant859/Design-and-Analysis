n = int(input("Enter number of elements: "))
a = []

for i in range(n):
    a.append(int(input("Enter number: ")))

gap = n // 2

while gap > 0:
    for i in range(gap, n):
        temp = a[i]
        j = i

        while j >= gap and a[j - gap] > temp:
            a[j] = a[j - gap]
            j -= gap

        a[j] = temp

    gap //= 2

print("Sorted list:", a)
