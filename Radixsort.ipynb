def counting_sort(a, exp):
    n = len(a)
    output = [0] * n
    count = [0] * 10

    for x in a:
        digit = (x // exp) % 10
        count[digit] += 1

    for i in range(1, 10):
        count[i] += count[i - 1]

    for i in range(n - 1, -1, -1):
        digit = (a[i] // exp) % 10
        output[count[digit] - 1] = a[i]
        count[digit] -= 1

    return output


a = list(map(int, input("Enter non-negative integers: ").split()))

if any(x < 0 for x in a):
    print("Enter non-negative integers only")
else:
    exp = 1
    maximum = max(a, default=0)

    while maximum // exp > 0:
        a = counting_sort(a, exp)
        exp *= 10

    print("Sorted list:", a)
